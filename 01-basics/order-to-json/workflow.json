{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "description": "POST an order. The map writes JSON text; the workflow parses it with json() and returns a JSON object."
      }
    },
    "actions": {
      "Compose_using_XSLT": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "content": "@{triggerBody()}",
            "mapSource": "deployed",
            "mapName": "exports/order-to-json.xslt"
          },
          "serviceProviderConfiguration": {
            "connectionName": "lamboXsltCompose",
            "operationId": "ComposeXslt",
            "serviceProviderId": "/serviceProviders/lamboXsltCompose"
          },
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {}
      },
      "Parse_JSON": {
        "type": "Compose",
        "description": "Turns the map's text output into a JSON object that later actions can use.",
        "inputs": "@json(body('Compose_using_XSLT')?['result'])",
        "runAfter": {
          "Compose_using_XSLT": [
            "Succeeded"
          ]
        }
      },
      "Response": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@outputs('Parse_JSON')"
        },
        "runAfter": {
          "Parse_JSON": [
            "Succeeded"
          ]
        }
      },
      "Error_response": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 500,
          "body": "@outputs('Compose_using_XSLT')"
        },
        "runAfter": {
          "Compose_using_XSLT": [
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateless"
}
