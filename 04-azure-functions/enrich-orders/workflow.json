{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "description": "POST a batch of orders (requests/batch.xml). Each customer name comes from the Function; repeated customers are answered from the per-transformation cache. An unknown customer fails the action and the workflow returns 502."
      }
    },
    "actions": {
      "Transform": {
        "type": "Scope",
        "actions": {
          "Compose_using_XSLT": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "content": "@{triggerBody()}",
                "mapSource": "deployed",
                "mapName": "functions/enrich-orders.xslt",
                "allowedFunctionAliases": [
                  "GetCustomerName"
                ],
                "timeoutSeconds": 30
              },
              "serviceProviderConfiguration": {
                "connectionName": "lamboXsltCompose",
                "operationId": "ComposeXslt",
                "serviceProviderId": "/serviceProviders/lamboXsltCompose"
              },
              "retryPolicy": {
                "type": "none"
              }
            },
            "runAfter": {}
          }
        },
        "runAfter": {}
      },
      "Response": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "@{body('Compose_using_XSLT')?['contentType']}",
            "X-Function-Calls": "@{body('Compose_using_XSLT')?['diagnostics']?['functionCallCount']}",
            "X-Function-Cache-Hits": "@{body('Compose_using_XSLT')?['diagnostics']?['functionCacheHitCount']}"
          },
          "body": "@body('Compose_using_XSLT')?['result']"
        },
        "runAfter": {
          "Transform": [
            "Succeeded"
          ]
        }
      },
      "Error_response": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 502,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "status": "failed",
            "action": "@{first(result('Transform'))?['name']}",
            "message": "@{coalesce(first(result('Transform'))?['outputs']?['body']?['message'], first(result('Transform'))?['error']?['message'])}"
          }
        },
        "runAfter": {
          "Transform": [
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
